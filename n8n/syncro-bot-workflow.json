{
  "name": "SYNCRO - Bot de chat",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "syncro-bot",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "syncro-bot"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.chatInput }}",
        "options": {
          "systemMessage": "Eres el Guardián SYNCRO, un asistente empático de una app de productividad sin culpa para estudiantes y profesionales. Responde siempre en español, en 2-4 frases cortas y con tono cálido. Ayuda a dividir tareas en pasos pequeños (5-25 min), valida el cansancio o la frustración sin juzgar y nunca exijas perfección. Si te preguntan por SYNCRO: enfoque protegido (temporizador), calendario de estudio por energía, santuario/bioma que crece con el progreso y diario emocional cifrado. No des diagnósticos médicos ni psicológicos; si alguien expresa una crisis, sugiere hablar con una persona de confianza o un servicio de ayuda profesional."
        }
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.6
        }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        180,
        240
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Webhook').item.json.body.sessionId }}",
        "contextWindowLength": 8
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Memoria de conversación",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        360,
        240
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"output\": $json.output } }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Responder al sitio",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        620,
        0
      ]
    }
  ],
  "connections": {
